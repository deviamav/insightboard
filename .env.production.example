# ── Production (.env) — copy to .env on server or let deploy.sh generate ──
DOMAIN=insightboard.example.com
ACME_EMAIL=ops@example.com

POSTGRES_USER=insightboard
POSTGRES_PASSWORD=CHANGE_ME_use_deploy_script_to_generate
POSTGRES_DB=insightboard

# JWT signing (min 32 chars) — not the login password
ADMIN_SECRET=CHANGE_ME_min_32_characters_random_secret

# First admin (created automatically if users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_login_password

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://insightboard.example.com