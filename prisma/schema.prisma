generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique @db.VarChar(50)
  passwordHash   String   @db.VarChar(128)
  role           String   @default("user") @db.VarChar(20)
  /** Bump to invalidate all existing JWTs for this user. */
  sessionVersion Int      @default(0) @map("session_version")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("users")
}

model Offer {
  id          String   @id @default(cuid())
  geo         String   @db.VarChar(10)
  title       String?  @db.VarChar(120)
  /** CPL | CPA | CRG */
  payoutModel String   @default("CPL") @map("payout_model") @db.VarChar(10)
  price       Decimal  @db.Decimal(12, 2)
  testPrice   Decimal? @map("test_price") @db.Decimal(12, 2)
  crMin       Decimal? @map("cr_min") @db.Decimal(5, 2)
  crMax       Decimal? @map("cr_max") @db.Decimal(5, 2)
  crNote      String?  @map("cr_note") @db.VarChar(100)
  /** Funnel IDs (legacy: names still supported when reading). */
  funnelsJson Json     @default("[]") @map("funnels_json")
  sourcesJson Json     @default("[]") @map("sources_json")
  lpdMin      Int?     @map("lpd_min")
  lpdMax      Int?     @map("lpd_max")
  notes       String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([geo])
  @@map("offers")
}

model Funnel {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(120)
  geo          String?  @db.VarChar(10)
  description  String?  @db.Text
  /** Relative path under data/funnels/{id}/ */
  zipFileName  String?  @map("zip_file_name") @db.VarChar(255)
  zipSizeBytes Int      @default(0) @map("zip_size_bytes")
  /** Saved quiz preview PDF under data/funnels/{id}/ */
  pdfFileName  String?  @map("pdf_file_name") @db.VarChar(255)
  entryFile    String?  @map("entry_file") @db.VarChar(500)
  fileCount    Int      @default(0) @map("file_count")
  hasPhp       Boolean  @default(false) @map("has_php")
  /** Manual flag: multi-step quiz vs long landing/article */
  isQuiz       Boolean  @default(false) @map("is_quiz")
  /** public | private */
  visibility   String   @default("public") @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([geo])
  @@map("funnels")
}

model DailyStat {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  periodType String   @default("day") @db.VarChar(10)
  geo        String   @db.VarChar(10)
  leads      Int      @default(0)
  valids     Int      @default(0)
  invalids   Int      @default(0)
  deposits   Int      @default(0)
  noSend     Int      @default(0)
  profit     Decimal  @default(0) @db.Decimal(12, 2)
  buyerName  String?  @db.VarChar(100)
  offerName  String   @default("") @db.VarChar(100)
  hour       Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([date, geo, periodType, offerName])
  @@index([date])
  @@index([geo])
  @@map("daily_stats")
}

model StatTemplate {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(100)
  geo        String   @db.VarChar(10)
  geoLabel   String?  @db.VarChar(100)
  periodType String   @default("day") @db.VarChar(10)
  anchorDate DateTime @db.Date
  leads      Int      @default(0)
  invalids   Int      @default(0)
  deposits   Int      @default(0)
  noSend     Int      @default(0)
  offerName  String   @default("") @db.VarChar(100)
  offersJson Json?    @map("offers_json")
  profit     Decimal  @default(0) @db.Decimal(12, 2)
  buyerName  String?  @db.VarChar(100)
  geosJson   Json?    @map("geos_json")
  buyerCount Int      @default(5) @map("buyer_count")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("stat_templates")
}

model AppConfig {
  id               String  @id @default("singleton")
  activeTemplateId String?

  @@map("app_config")
}
