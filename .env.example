# Database
DATABASE_URL="postgresql://insightboard:changeme@localhost:5432/insightboard?schema=public"
POSTGRES_USER=insightboard
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=insightboard

# JWT signing secret (min 32 chars) — NOT the login password
ADMIN_SECRET=changeme_admin_secret_min_32_chars_long

# First admin account (created on first deploy if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_strong_admin_password

# Local dev
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production — use deploy.sh on Ubuntu (generates .env automatically)
# DOMAIN=insightboard.example.com
# ACME_EMAIL=ops@example.com